<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sales_workflow" model="ir.module.category">
        <field name="name">Sales Approval Workflow</field>
        <field name="description">Controls access to the sales quotation approval workflow.</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_sales_workflow_user" model="res.groups">
        <field name="name">Sales Workflow User</field>
        <field name="category_id" ref="sales_management_customization.module_category_sales_workflow"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_sales_workflow_manager" model="res.groups">
        <field name="name">Sales Workflow Manager</field>
        <field name="category_id" ref="sales_management_customization.module_category_sales_workflow"/>
        <field name="implied_ids" eval="[(4, ref('sales_management_customization.group_sales_workflow_user')), (4, ref('sales_team.group_sale_manager'))]"/>
    </record>

    <record id="group_sales_workflow_director" model="res.groups">
        <field name="name">Sales Workflow Director</field>
        <field name="category_id" ref="sales_management_customization.module_category_sales_workflow"/>
        <field name="implied_ids" eval="[(4, ref('sales_management_customization.group_sales_workflow_manager'))]"/>
    </record>
</odoo>
