<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_reject_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.approval.reject.wizard.form</field>
        <field name="model">sale.order.approval.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Quotation">
                <group>
                    <field name="sale_order_id"/>
                    <field name="reason" placeholder="Explain why this quotation is being rejected..."/>
                </group>
                <footer>
                    <button name="action_reject" string="Reject Quotation" type="object" class="btn-danger"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
