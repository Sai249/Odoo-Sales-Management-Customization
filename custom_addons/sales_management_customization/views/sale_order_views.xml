<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_sales_approval_workflow" model="ir.ui.view">
        <field name="name">sale.order.form.sales.approval.workflow</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_submit_for_approval"
                        type="object"
                        string="Submit for Approval"
                        class="btn-primary"
                        groups="sales_management_customization.group_sales_workflow_user"
                        invisible="state not in ['draft', 'sent'] or not approval_required or approval_state not in ['not_required', 'rejected']"/>
                <button name="action_manager_approve"
                        type="object"
                        string="Manager Approve"
                        class="btn-primary"
                        groups="sales_management_customization.group_sales_workflow_manager"
                        invisible="approval_state != 'manager_pending'"/>
                <button name="action_director_approve"
                        type="object"
                        string="Director Approve"
                        class="btn-primary"
                        groups="sales_management_customization.group_sales_workflow_director"
                        invisible="approval_state != 'director_pending'"/>
                <button name="action_open_reject_wizard"
                        type="object"
                        string="Reject"
                        class="btn-secondary"
                        groups="sales_management_customization.group_sales_workflow_manager,sales_management_customization.group_sales_workflow_director"
                        invisible="approval_state not in ['manager_pending', 'director_pending']"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Approval Workflow" name="approval_workflow">
                    <group>
                        <group string="Workflow Status">
                            <field name="approval_required"/>
                            <field name="requires_director_approval" invisible="not approval_required"/>
                            <field name="approval_state" widget="badge"
                                   decoration-warning="approval_state in ['manager_pending', 'director_pending']"
                                   decoration-success="approval_state == 'approved'"
                                   decoration-danger="approval_state == 'rejected'"/>
                            <field name="rejection_reason" invisible="approval_state != 'rejected'"/>
                        </group>
                        <group string="Review Details">
                            <field name="approval_submitted_by_id"/>
                            <field name="approval_submitted_on"/>
                            <field name="approval_reviewed_by_id"/>
                            <field name="approval_reviewed_on"/>
                        </group>
                    </group>
                    <separator string="Approval Audit Trail"/>
                    <field name="approval_history_ids" nolabel="1" readonly="1">
                        <list create="0" delete="0" edit="0">
                            <field name="action_date"/>
                            <field name="action"/>
                            <field name="from_state"/>
                            <field name="to_state"/>
                            <field name="user_id"/>
                            <field name="note"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_quotation_tree_inherit_sales_approval_workflow" model="ir.ui.view">
        <field name="name">sale.order.list.sales.approval.workflow</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-warning">approval_state in ['manager_pending', 'director_pending']</attribute>
                <attribute name="decoration-success">approval_state == 'approved'</attribute>
                <attribute name="decoration-danger">approval_state == 'rejected'</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="approval_state" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_filter_inherit_sales_approval_workflow" model="ir.ui.view">
        <field name="name">sale.order.search.sales.approval.workflow</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Pending My Approval" name="pending_my_approval"
                        domain="[('approval_state', 'in', ['manager_pending', 'director_pending'])]"/>
                <filter string="Approved" name="approval_approved" domain="[('approval_state', '=', 'approved')]"/>
                <filter string="Rejected" name="approval_rejected" domain="[('approval_state', '=', 'rejected')]"/>
                <group expand="0" string="Approval Status">
                    <filter string="Approval Status" name="approval_state_group" context="{'group_by': 'approval_state'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
