<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_sales_approval_workflow" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.sales.approval.workflow</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale_management.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="online_signature" position="after">
                <setting id="sales_approval_manager_threshold" help="Quotations at or above this amount require a manager's approval.">
                    <field name="approval_threshold"/>
                </setting>
                <setting id="sales_approval_director_threshold" help="Quotations at or above this amount require manager and director approval.">
                    <field name="director_approval_threshold"/>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
